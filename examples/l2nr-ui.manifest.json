{
  "$schema": "../schemas/ui-node-manifest.schema.json",
  "schemaVersion": 1,
  "name": "radiant-dial",
  "label": "Radiant Dial",
  "component": "src/components/ThermostatDial.tsx",
  "dashboard": {
    "width": 6,
    "height": 6
  },
  "input": {
    "source": "msg.payload"
  },
  "output": {
    "target": "msg.payload"
  },
  "display": {
    "valueProperty": "payload.ambient",
    "caption": "Ambient Temperature",
    "label": "TEMP °C",
    "min": 0,
    "max": 50
  }
}
